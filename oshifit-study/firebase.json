{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/proposal",
        "function": {
          "functionId": "proposal",
          "region": "asia-northeast1"
        }
      },
      {
        "source": "/editor",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/editor/",
        "destination": "/editor",
        "type": 301
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "functions": {
      "port": 5001
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "node -e \"require('fs').copyFileSync('public/ai_prompt.js','functions/ai_prompt.js')\""
      ]
    }
  ]
}
