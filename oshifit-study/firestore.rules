rules_version = '2';
// OshiFit 研究版の Firestore ルール。参加者（メールアドレスでログイン）は自分の記録だけ読み書きでき、開発者（admins に登録した大学アカウント）は全件を閲覧だけできる。
// 参加をやめても記録は消さない（倫理審査の同意どおり）。やめたあとは書き込めない。
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      // Microsoft のアカウントは email_verified が付かないことがあるため、Google・Microsoft でのログインも認める
      return signedIn()
        && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider in ['google.com', 'microsoft.com'])
        && exists(/databases/$(db)/documents/admins/$(request.auth.token.email));
    }
    function unchanged(f) {   // 一度入れた値は変えられない
      return !(f in resource.data) || (f in request.resource.data && request.resource.data[f] == resource.data[f]);
    }

    match /participants/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow create: if owner(uid)
        && request.resource.data.mode == 'study'
        && request.resource.data.pid is string && request.resource.data.pid.size() == 9
        && !('group' in request.resource.data) && !('final' in request.resource.data);
      allow update: if owner(uid)
        && !(resource.data.get('withdrawn', false) == true)                 // やめたあとは書き込めない
        && (!('withdrawn' in request.resource.data) || request.resource.data.withdrawn == true)
        && unchanged('pid') && unchanged('mode') && unchanged('createdAt') && unchanged('consentedAt')
        // 選んだ群・提案・見込み・決めた時刻は変えられない
        && unchanged('group') && unchanged('planIds') && unchanged('decidedAt') && unchanged('pred') && unchanged('plansOffered')
        // 開始時の質問を終えたら、回答は変えられない。最後の調査も一度だけ
        && (!(resource.data.get('baselineDone', false) == true) || (unchanged('answers') && unchanged('baselineAt')))
        && unchanged('final')
        && (!('group' in request.resource.data) || request.resource.data.group in ['A', 'B', 'C'])
        && (('group' in resource.data) || !('group' in request.resource.data) || request.resource.data.decidedAt == request.time)
        && (!('final' in request.resource.data) || 'group' in resource.data);
      allow delete: if false;        // 記録は消さない（参加をやめても研究に使う）

      match /checkins/{week} {
        allow read: if owner(uid) || isAdmin();
        allow create: if owner(uid)
          && week in ['1', '2', '3', '4', '5', '6']
          && request.resource.data.week == int(week)
          && get(/databases/$(db)/documents/participants/$(uid)).data.get('group', '') in ['B', 'C']
          && !(get(/databases/$(db)/documents/participants/$(uid)).data.get('withdrawn', false) == true);
        allow update, delete: if false;   // 振り返りはあとから書き換えない・消さない
      }
    }
    match /{path=**}/checkins/{week} { allow read: if isAdmin(); }
    match /admins/{email} { allow read: if isAdmin(); allow write: if false; }
    match /pilots/{pid} { allow read: if isAdmin(); allow write: if false; }   // プレ実験の参加ID（コンソールから研究者が入れる）
  }
}
